# Скопируй в .env и заполни. Относительные пути — от корня проекта.

# LLM (OpenAI-совместимый API)
LLM_API_KEY=sk-local
LLM_BASE_URL=http://localhost:55551/v1
LLM_MODEL=gemma

# TTS (Fish Audio S2 Pro через s2.cpp)
TTS_ENABLED=true
TTS_URL=http://127.0.0.1:3030/generate
TTS_VOICE=jarvis
TTS_VOICE_DIR=assets/voices
TTS_AUTOSTART=true
TTS_SERVER_BIN=~/s2.cpp/build/s2
TTS_MODEL=~/.models/s2-pro/s2-pro-q4_k_m.gguf
TTS_TOKENIZER=~/.models/s2-pro/tokenizer.json
TTS_SERVER_ARGS=--cuda 0 -ngl -1
TTS_REFERENCE=assets/voices/jarvis_reference.mp3
TTS_REFERENCE_TEXT=assets/voices/jarvis_reference.txt
