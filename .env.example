LLM_API_KEY=
LLM_BASE_URL=
LLM_API_MODEL=
# Subscription model IDs depend on the signed-in ChatGPT account.
LLM_SUBSCRIPTION_MODEL=
CHATGPT_SUBSCRIPTION_ENABLED=false
# Reasoning effort depends on the selected model. GPT-6 Luna currently offers
# low, medium, high, xhigh, max.
# Empty means provider default.
LLM_REASONING_EFFORT=

# API-only memory profiles. Set provider/model IDs.
MEMORY_MODEL_TEXT=
MEMORY_MODEL_TEXT_IMAGE=
MEMORY_MODEL_TEXT_IMAGE_VIDEO=
MEMORY_MODEL_TEXT_IMAGE_AUDIO_VIDEO=

# Optional dedicated subscription memory model (text and images only).
MEMORY_SUBSCRIPTION_MODEL=
