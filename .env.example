# Скопируй в .env и заполни. Относительные пути — от корня проекта.
# Настройки конкретных capability лежат рядом с ними: .jarvis/actions/<id>/.env,
# .jarvis/handlers/<id>/.env, .jarvis/modules/<id>/.env.

# LLM (OpenAI-совместимый API)
LLM_API_KEY=sk-local
LLM_BASE_URL=http://localhost:55551/v1
LLM_MODEL=gemma
JARVIS_DIR=.jarvis
